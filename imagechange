// 1. Types for strong TypeScript safety
export interface ImageItem {
  id: string;
  url: string;
  alt: string;
}

export interface PortfolioItem {
  category: string;
  src: string;
  alt: string;
  shape: 'tall' | 'standard' | 'wide';
}

export interface JournalPost {
  title: string;
  category: string;
  excerpt: string;
  image: string;
}

export type ImageCategory =
  | 'hero'
  | 'portrait'
  | 'family'
  | 'couple'
  | 'lifestyle'
  | 'branding'
  | 'editorial'
  | 'coast'
  | 'detail'
  | 'friends'
  | 'man';

export type ImageCollection = Record<ImageCategory, ImageItem[]>;

